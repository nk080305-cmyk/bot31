TELEGRAM_BOT_TOKEN=your_bot_token_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
# Always attempt direct vision extraction for fine notice number + license plate
# on uploaded JPG/PNG photos before falling back to OCR→LLM for those fields.
VISION_EXTRACT=0
# Optional: set an explicit encryption key (defaults to derivation from bot token)
ENCRYPTION_KEY=
LOG_LEVEL=INFO
# Enable multi-variant OCR preprocessing (default off)
OCR_MULTI_PREPROCESS=0
# Enable multi-variant OCR preprocessing (alias, takes precedence over OCR_MULTI_PREPROCESS)
OCR_MULTI_VARIANTS=0
# Enable verbose OCR debug logging - logs candidate scores, context proximity,
# and chosen winners. Secrets are never printed in full. (default off)
OCR_DEBUG=0
